{
  "$schema": "http://json.schemastore.org/template",
  "author": "MiEmpresa",
  "name": "MiEmpresa Clean Architecture PostgREST",
  "identity": "MiEmpresa.DotNet.CleanArchitecture",
  "groupIdentity": "MiEmpresa.DotNet.CleanArchitecture",
  "shortName": "cleanarch",
  "description": "Plantilla corporativa ASP.NET Core + Clean Architecture. Acceso a PostgreSQL solo mediante PostgREST RPC y Functions.",
  "classifications": [ "Web", "WebAPI", "Clean Architecture" ],
  "tags": {
    "language": "C#",
    "type": "solution",
    "platform": ".NET"
  },
  "sourceName": "MiProyecto",
  "preferNameDirectory": true,
  "defaultName": "MiProyecto",
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Si es true, no restaura los paquetes NuGet al crear el proyecto."
    },
    "nameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "replaces": "miproyecto"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".vs/**",
            "**/.vs/**",
            "**/bin/**",
            "**/obj/**",
            "**/*.user",
            "**/TestResults/**",
            "arquitecturaLimpia.slnx",
            ".env"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "MiProyecto.sln" }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        { "text": "Ejecute 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
